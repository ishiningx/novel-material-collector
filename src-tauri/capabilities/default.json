{
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "**" }]
    },
    "core:path:default",
    "core:path:allow-resolve-directory",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://gitee.com/*" },
        { "url": "https://*.gitee.com/*" },
        { "url": "https://raw.giteeusercontent.com/*" }
      ]
    },
    "opener:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://gitee.com/*" },
        { "url": "https://*.gitee.com/*" }
      ]
    }
  ]
}
